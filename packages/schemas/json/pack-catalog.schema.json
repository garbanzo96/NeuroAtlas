{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "currentRelease": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+(-[a-z0-9.]+)?$"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d+(-[a-z0-9.]+)?$"
          },
          "knowledge": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assetId": {
                  "type": "string",
                  "pattern": "^asset\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                  "description": "Identificador estable de asset (prefijo \"asset.\")"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "assetId",
                "path",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "knowledge",
          "assets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "currentRelease",
    "releases"
  ],
  "additionalProperties": false,
  "title": "NeuroAtlas pack catalog"
}
