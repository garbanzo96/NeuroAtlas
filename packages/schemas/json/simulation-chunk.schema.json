{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "ms"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "units",
        "values"
      ],
      "additionalProperties": false
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "units": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "units",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "done": {
      "type": "boolean"
    }
  },
  "required": [
    "runId",
    "index",
    "time",
    "variables",
    "done"
  ],
  "additionalProperties": false,
  "title": "NeuroAtlas simulation chunk"
}
